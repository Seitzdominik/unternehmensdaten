{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"login": true,
	"preferredVersions": { "php": "8.3", "wp": "latest" },
	"constants": {
		"UNDT_AUDIT_NAME": "multisite",
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": "/wordpress/build/dev/audit/debug-multisite.log",
		"WP_DEBUG_DISPLAY": false,
		"SAVEQUERIES": true
	},
	"steps": [
		{ "step": "runPHP", "code": "<?php file_put_contents('/wordpress/undt-audit-name.txt', 'multisite'); @mkdir('/wordpress/wp-content/mu-plugins'); copy('/wordpress/build/dev/audit/mu-undt-audit.php', '/wordpress/wp-content/mu-plugins/undt-audit.php');" },
		{ "step": "installPlugin", "pluginData": { "resource": "vfs", "path": "/wordpress/build/unternehmensdaten.zip" }, "options": { "activate": false } }, { "step": "enableMultisite" }, { "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; require_once ABSPATH . 'wp-admin/includes/plugin.php'; $r = activate_plugin( 'unternehmensdaten/unternehmensdaten.php', '', true ); file_put_contents('/wordpress/build/dev/audit/ms-activate.txt', is_wp_error($r) ? $r->get_error_message() : 'network-activated');" },
		{ "step": "runPHP", "code": "<?php require '/wordpress/build/dev/audit/seed-audit.php';" },
		{ "step": "runPHP", "code": "<?php $undt_uri = '/'; $undt_out = 'home'; require '/wordpress/build/dev/audit/render.php';" },
		{ "step": "runPHP", "code": "<?php $undt_uri = '/alle-bloecke/'; $undt_out = 'all'; require '/wordpress/build/dev/audit/render.php';" },
		{ "step": "runPHP", "code": "<?php $undt_uri = '/ohne-bloecke/'; $undt_out = 'plain'; require '/wordpress/build/dev/audit/render.php';" },
		{ "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; $b = get_option('undt_banner'); $b['enabled'] = 0; update_option('undt_banner', $b);" },
		{ "step": "runPHP", "code": "<?php $undt_uri = '/ohne-bloecke/'; $undt_out = 'plain-nobanner'; require '/wordpress/build/dev/audit/render.php';" },
		{ "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; $b = get_option('undt_banner'); $b['enabled'] = 1; update_option('undt_banner', $b);" },
		{ "step": "runPHP", "code": "<?php require '/wordpress/build/dev/audit/env.php';" },
		{ "step": "runPHP", "code": "<?php require '/wordpress/build/dev/audit/uninstall-keep.php';" }
	]
}
