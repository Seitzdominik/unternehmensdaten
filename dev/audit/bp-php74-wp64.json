{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"login": true,
	"preferredVersions": { "php": "7.4", "wp": "6.4" },
	"constants": {
		"UNDT_AUDIT_NAME": "php74-wp64",
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": "/wordpress/build/dev/audit/debug-php74-wp64.log",
		"WP_DEBUG_DISPLAY": false,
		"SAVEQUERIES": true
	},
	"steps": [
		{ "step": "runPHP", "code": "<?php file_put_contents('/wordpress/undt-audit-name.txt', 'php74-wp64'); @mkdir('/wordpress/wp-content/mu-plugins'); copy('/wordpress/build/dev/audit/mu-undt-audit.php', '/wordpress/wp-content/mu-plugins/undt-audit.php');" },
		{ "step": "installPlugin", "pluginData": { "resource": "vfs", "path": "/wordpress/build/unternehmensdaten.zip" }, "options": { "activate": true } },
		{ "step": "runPHP", "code": "<?php require '/wordpress/build/dev/audit/seed-audit.php';" },
		{ "step": "runPHP", "code": "<?php $undt_uri = '/'; $undt_out = 'home'; require '/wordpress/build/dev/audit/render.php';" },
		{ "step": "runPHP", "code": "<?php $undt_uri = '/alle-bloecke/'; $undt_out = 'all'; require '/wordpress/build/dev/audit/render.php';" },
		{ "step": "runPHP", "code": "<?php $undt_uri = '/ohne-bloecke/'; $undt_out = 'plain'; require '/wordpress/build/dev/audit/render.php';" },
		{ "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; $b = get_option('undt_banner'); $b['enabled'] = 0; update_option('undt_banner', $b);" },
		{ "step": "runPHP", "code": "<?php $undt_uri = '/ohne-bloecke/'; $undt_out = 'plain-nobanner'; require '/wordpress/build/dev/audit/render.php';" },
		{ "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; $b = get_option('undt_banner'); $b['enabled'] = 1; update_option('undt_banner', $b);" },
		{ "step": "runPHP", "code": "<?php require '/wordpress/build/dev/audit/env.php';" },
		{ "step": "runPHP", "code": "<?php require '/wordpress/build/dev/audit/uninstall-keep.php';" }
	]
}
